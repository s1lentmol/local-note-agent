# Copy to .env, replace the placeholder password in BOTH values.
# URL-encode special characters in the URL password.
POSTGRES_USER=note_agent
POSTGRES_DB=note_agent
POSTGRES_PASSWORD=replace-with-local-password
NOTE_AGENT_DATABASE_URL=postgresql://note_agent:replace-with-local-password@db:5432/note_agent
NOTE_AGENT_PORT=8000
NOTE_AGENT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# For native API processes export NOTE_AGENT_* variables explicitly.
# Compose does not publish the database port.

# Opt in only when a PostgreSQL worker with embeddings is running.
NOTE_AGENT_PROCESSING_ENABLED=false
# Native worker environment (export explicitly; URLs are relative to its host):
# EMBEDDING_BASE_URL=http://127.0.0.1:11435
# NOTE_AGENT_CHUNK_SIZE=600
# NOTE_AGENT_CHUNK_OVERLAP=80
# NOTE_AGENT_CHUNK_BATCH_SIZE=16
