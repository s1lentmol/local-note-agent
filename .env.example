# Docker Compose. Native Python processes read exported NOTE_AGENT_* variables.
NOTE_AGENT_PORT=8000
NOTE_AGENT_WHISPER_MODEL=base
NOTE_AGENT_OCR_LANGUAGE=rus+eng
NOTE_AGENT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional installed Python adapter factory: package.module:create_processor
NOTE_AGENT_KNOWLEDGE_ADAPTER=
# Native Python only; Docker stores data in its named volume.
# NOTE_AGENT_DATA_DIR=/absolute/path/to/data
# Optional limits, supported by Docker Compose and native Python:
# NOTE_AGENT_IMAGE_MAX_BYTES=10485760
# NOTE_AGENT_AUDIO_MAX_BYTES=52428800
# NOTE_AGENT_AUDIO_MAX_SECONDS=600
# NOTE_AGENT_JOB_TIMEOUT_SECONDS=900
